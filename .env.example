# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LOTTERY_DISCORD_WEBHOOK_URL: Optional. Discord channel for the Monday 08:00 KST
# 로또/연금복권 picks. Falls back to DISCORD_WEBHOOK_URL when unset.
LOTTERY_DISCORD_WEBHOOK_URL=""

# LOTTERY_TRIGGER_TOKEN: Optional. Lets `POST /api/lottery-picks?token=...` send
# this week's picks right away (for testing). Leave empty to disable.
LOTTERY_TRIGGER_TOKEN=""

# Discord bot for /연금 and /로또 (new numbers when a 연금 number is sold out).
# From https://discord.com/developers/applications → your app.
# DISCORD_PUBLIC_KEY verifies requests to /api/discord-interactions;
# the other three are only used by /api/discord-register-commands.
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_TOKEN=""
# Optional: your server's ID, so the commands show up there immediately.
DISCORD_GUILD_ID=""
